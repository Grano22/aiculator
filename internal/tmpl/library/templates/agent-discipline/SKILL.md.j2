template:
  vars:
    timeout: 120s
    retries: 3
    subagents: when
    max_subagents: 4
name: agent-discipline
description: Sets working rules for this session, covering when to use subagents, command timeouts and retries, the reply format, and a confirm-before-acting flow. Use when the user asks for disciplined, careful or step-by-step work, or asks to apply the working rules.
license: MIT
compatibility: Works in any harness that reads skills. These are instructions to the model, not technical limits.
metadata:
  version: "1.0.0"
  aiculator.kind: behavior
